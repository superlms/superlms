# Caddy — public TLS entrypoint for the lite single-box deploy.
# Replaces the ALB + ACM cert. Certificates are obtained from Let's Encrypt
# automatically (free) and auto-renew. Requires ports 80 + 443 open and DNS
# for the domain pointing at this box's public IP.
#
# deploy.sh validates this file and recreates Caddy when it changes (it is
# mounted as a single file, which a git pull replaces under a running
# container); a file that does not validate leaves Caddy on the old one.

{
	email {$TLS_EMAIL}
	# Uncomment while testing to avoid Let's Encrypt rate limits:
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	# School custom domains (the https:// site below): a certificate is fetched
	# the first time one is visited — only once the app says it is the domain
	# of a published school website (App\Http\Controllers\TlsCheckController),
	# so no one can make the box get certificates for any name they point here.
	on_demand_tls {
		ask http://web:80/internal/tls-check
	}
}

# Main app — apex + www.
{$APP_DOMAIN}, www.{$APP_DOMAIN} {
	encode zstd gzip

	# Real client IP (Caddy is the only hop in front of the app now).
	reverse_proxy web:80 {
		header_up X-Forwarded-Proto https
		health_uri /up
		health_interval 15s
	}

	# Uploads go to S3/CloudFront (AWS_URL), not through here, so no big-body
	# tuning needed beyond the app's own 64m nginx limit.
	request_body {
		max_size 64MB
	}
}

# ── Media CDN (cdn.superlms.in) — served from THIS box, origin = new S3 bucket.
# Replaces the old-account CloudFront so the media domain no longer depends on
# that (soon-to-be-decommissioned) account. Only the public media prefixes are
# ever referenced (admin/ super-admin/ superadmin/ website/); db-backups/ and
# livewire-tmp/ stay private. Caddy issues/renews the cdn cert from Let's
# Encrypt automatically once cdn.{$APP_DOMAIN} resolves to this box.
cdn.{$APP_DOMAIN} {
	encode zstd gzip
	reverse_proxy https://superlms-media-033649549123.s3.ap-south-1.amazonaws.com {
		header_up Host superlms-media-033649549123.s3.ap-south-1.amazonaws.com
	}
}

# ── School custom domains ─────────────────────────────────────────────────
# A school's own domain (Super Admin → School Website), once its DNS points
# at this box: the app serves that school's website for it
# (App\Http\Middleware\ServeSchoolSite), on a certificate fetched on demand.
https:// {
	tls {
		on_demand
	}

	encode zstd gzip

	reverse_proxy web:80 {
		header_up X-Forwarded-Proto https
	}

	request_body {
		max_size 64MB
	}
}

# The schools' attendance machines (ADMS push, App\Http\Controllers\BiometricPushController)
# speak plain http and do not follow a redirect: their /iclock/ calls go
# straight to the app, on the main domain as on the box's IP address.
# Everything else on plain http goes to https, as before.
http://{$APP_DOMAIN}, http://www.{$APP_DOMAIN} {
	handle /iclock/* {
		reverse_proxy web:80
	}
	handle {
		redir https://{host}{uri} permanent
	}
}

# …and plain http on any other name (or the bare IP) goes to https too.
http:// {
	handle /iclock/* {
		reverse_proxy web:80
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
