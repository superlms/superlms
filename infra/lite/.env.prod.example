# ── SuperLMS lite (single-box) production env ──────────────────────────────
# Copy to infra/lite/.env on the box and fill in. Keep it chmod 600 — this is
# the only place secrets live now (no Secrets Manager in the lite setup).
#   cp .env.prod.example .env && chmod 600 .env
#
# Generate APP_KEY once:  docker run --rm superlms/app:prod php artisan key:generate --show
# (or copy the OLD account's APP_KEY — REQUIRED if the DB has encrypted columns,
#  e.g. users.password_plain. Bcrypt password hashes do NOT need it.)

APP_NAME=SuperLMS
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Kolkata
APP_URL=https://superlms.in
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# Caddy TLS
APP_DOMAIN=superlms.in
TLS_EMAIL=admin@superlms.in

# ── Database (MySQL container on THIS box) ─────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=superlms
DB_USERNAME=superlms
DB_PASSWORD=CHANGE_ME_strong_password
DB_ROOT_PASSWORD=CHANGE_ME_different_strong_password

# ── Redis (container on THIS box) ──────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Media storage: keep S3 + CloudFront (nearly free, keeps the CDN URL) ────
# Create a bucket + CloudFront in the NEW account (see README) OR point at the
# migrated bucket. To drop S3 entirely, set FILESYSTEM_DISK=local (bigger EBS,
# no CDN) — not recommended if the mobile app / cdn.superlms.in is in use.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Where daily DB backups are uploaded (see backup-db.sh). Can be the same
# bucket under a prefix, or a separate cheaper bucket.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=db-backups

# ── Mail (ZeptoMail) — copy values from the old account's secret ───────────
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1
ZEPTOMAIL_API_TOKEN=
ZEPTOMAIL_FROM_EMAIL=noreply@superlms.in
ZEPTOMAIL_FROM_NAME=SuperLMS
ZEPTOMAIL_OTP_TEMPLATE_KEY=
ZEPTOMAIL_STUDENT_PASSWORD_TEMPLATE_KEY=
ZEPTOMAIL_TEACHER_PASSWORD_TEMPLATE_KEY=
ZEPTOMAIL_WELCOME_TEMPLATE_KEY=
ZEPTOMAIL_FEE_RECEIPT_TEMPLATE_KEY=
ZEPTOMAIL_ANNOUNCEMENT_TEMPLATE_KEY=
ZEPTOMAIL_PASSWORD_CHANGED_TEMPLATE_KEY=
ZEPTOMAIL_SCHOOL_CREATION_TEMPLATE_KEY=

# ── PhonePe (online fee payment) ───────────────────────────────────────────
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=1
PHONEPE_ENV=production
PHONEPE_WEBHOOK_USERNAME=
PHONEPE_WEBHOOK_PASSWORD=

# ── Firebase (push notifications) — full service-account JSON on one line ───
FIREBASE_CREDENTIALS=
